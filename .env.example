# Copy to .env.local and fill in values.
# Admin → Settings lists which integrations are configured (no secret values).

# Google Analytics 4 — optional; loads only after visitor accepts analytics cookies
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel / Dataset ID — optional; loads only after analytics consent
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase (required for sample requests and app data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sample request notifications (Resend) — optional; leads still save if unset
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Public landing (/content-packages) — which sample package/video to show
# Optional: pin an exact render or package; otherwise auto-picks the best eligible package.
# Test / scene-editor packages are excluded by default (see landing-sample-config.ts).
# LANDING_SAMPLE_VIDEO_JOB_ID=
# LANDING_SAMPLE_PACKAGE_ID=
# LANDING_SAMPLE_EXCLUDE_PACKAGE_IDS=

# Scene Types (Phase 2+) — when false, only IMAGE scenes render (production default).
# SCENE_TYPES_ENABLED=false
#
# CHECKLIST production rollout — comma-separated project UUIDs, or `*` for all projects.
# Empty/unset = no CHECKLIST project access. Requires SCENE_TYPES_ENABLED=true
# and CHECKLIST_GENERATION_MODE=enabled. See docs/video-production-activation.md.
# CHECKLIST_GENERATION_MODE=off|shadow|enabled
# CHECKLIST_ENABLED_PROJECT_IDS=*

# Runway image-to-video (not wired into the production FFmpeg pipeline yet).
# Same names will be needed on the video worker host when generation is enabled.
# Official key name: RUNWAYML_API_SECRET. Do not put real values here.
# RUNWAYML_API_SECRET=
# RUNWAY_VIDEO_MODEL=gen4.5
#
# Timeouts (do not confuse these):
# - RUNWAY_VIDEO_HTTP_TIMEOUT_MS: single HTTP request (create POST or poll GET).
# - RUNWAY_VIDEO_POLL_TIMEOUT_MS: max wall-clock wait while polling a task to
#   SUCCEEDED/FAILED/CANCELLED (not an HTTP timeout).
# - RUNWAY_VIDEO_POLL_INTERVAL_MS: delay between poll GET requests.
# RUNWAY_VIDEO_HTTP_TIMEOUT_MS=60000
# RUNWAY_VIDEO_POLL_TIMEOUT_MS=180000
# RUNWAY_VIDEO_POLL_INTERVAL_MS=2000
# Legacy alias (step 1): RUNWAY_VIDEO_TIMEOUT_MS still maps to poll wall-clock
# if RUNWAY_VIDEO_POLL_TIMEOUT_MS is unset — prefer the new name.
#
# Scene video generation executor (all scenes of a video). Default OFF.
# Presence of RUNWAYML_API_SECRET does NOT enable this. Paid runs also require
# confirmPaidRun=true on the executor call and a finite positive maxBudgetUsd.
# Not wired into the production job runner.
SCENE_VIDEO_GENERATION_ENABLED=false

# Internal AI Media Benchmark Lab (admin /settings/ai-media-benchmark).
# All default OFF. Presence of API keys does NOT enable paid benchmark runs.
# Enable one flag at a time when you are ready for a real comparison.
# AI_MEDIA_BENCHMARK_VIDEO_ENABLED=false
# AI_MEDIA_BENCHMARK_VOICE_ENABLED=false
# AI_MEDIA_BENCHMARK_SOUND_ENABLED=false
# AI_MEDIA_BENCHMARK_TEXT_VIDEO_ENABLED=false
